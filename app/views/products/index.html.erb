<% content_for :title, "在庫一覧" %>

<% if notice.present? %>
  <p class="mb-6 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800 ring-1 ring-emerald-100"><%= notice %></p>
<% end %>

<div class="mb-8 flex items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-gray-900">在庫一覧</h1>
    <p class="mt-1 text-sm text-gray-500"><%= @products.size %> 件の商品</p>
  </div>
  <%= link_to new_product_path,
        class: "inline-flex items-center gap-1.5 rounded-lg bg-gray-900 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-gray-700" do %>
    <span class="text-base leading-none">＋</span> 新規登録
  <% end %>
</div>

<% if @products.any? %>
  <div id="products" class="space-y-2.5">
    <% @products.each do |product| %>
      <%= render product %>
    <% end %>
  </div>
<% else %>
  <div class="rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-16 text-center">
    <p class="text-sm text-gray-500">まだ商品が登録されていません。</p>
    <%= link_to "最初の商品を登録する", new_product_path, class: "mt-3 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  </div>
<% end %>
