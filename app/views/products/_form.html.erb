<%= form_with(model: product, class: "space-y-5") do |form| %>
  <% if product.errors.any? %>
    <div class="rounded-xl bg-red-50 p-4 ring-1 ring-red-100">
      <h2 class="text-sm font-semibold text-red-800"><%= product.errors.count %>件のエラーにより保存できませんでした</h2>
      <ul class="mt-2 list-inside list-disc text-sm text-red-700">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "mb-1.5 block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name,
          class: "block w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-gray-900 transition placeholder:text-gray-400 focus:border-gray-900 focus:bg-white focus:outline-none focus:ring-4 focus:ring-gray-900/10" %>
  </div>

  <div>
    <%= form.label :quantity, class: "mb-1.5 block text-sm font-medium text-gray-700" %>
    <%= form.number_field :quantity,
          class: "block w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-gray-900 transition focus:border-gray-900 focus:bg-white focus:outline-none focus:ring-4 focus:ring-gray-900/10" %>
  </div>

  <div>
    <%= form.label :category, class: "mb-1.5 block text-sm font-medium text-gray-700" %>
    <%= form.text_field :category,
          class: "block w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-gray-900 transition placeholder:text-gray-400 focus:border-gray-900 focus:bg-white focus:outline-none focus:ring-4 focus:ring-gray-900/10" %>
  </div>

  <div>
    <%= form.label :status, class: "mb-1.5 block text-sm font-medium text-gray-700" %>
    <%= form.select :status,
          Product.statuses.keys.map { |key| [ Product::STATUS_LABELS[key], key ] },
          {},
          class: "block w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-gray-900 transition focus:border-gray-900 focus:bg-white focus:outline-none focus:ring-4 focus:ring-gray-900/10" %>
  </div>

  <div class="pt-2">
    <%= form.submit class: "inline-flex cursor-pointer items-center rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-gray-700" %>
  </div>
<% end %>
