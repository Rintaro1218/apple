<% content_for :title, "商品の詳細" %>

<% if notice.present? %>
  <p class="mb-6 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800 ring-1 ring-emerald-100"><%= notice %></p>
<% end %>

<div class="mb-6">
  <%= link_to "← 一覧に戻る", products_path, class: "text-sm text-gray-500 transition hover:text-gray-900" %>
</div>

<div class="rounded-2xl border border-gray-200/70 bg-white p-6 shadow-sm">
  <div class="flex items-center gap-4">
    <div class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-indigo-50 text-lg font-semibold text-indigo-600">
      <%= @product.name.to_s.first %>
    </div>
    <h1 class="text-xl font-semibold tracking-tight text-gray-900"><%= @product.name %></h1>
  </div>

  <dl class="mt-6 grid grid-cols-3 gap-3">
    <div class="rounded-xl bg-gray-50 p-4">
      <dt class="text-xs text-gray-500">数量</dt>
      <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @product.quantity %></dd>
    </div>
    <div class="rounded-xl bg-gray-50 p-4">
      <dt class="text-xs text-gray-500">カテゴリ</dt>
      <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @product.category.presence || "—" %></dd>
    </div>
    <div class="rounded-xl bg-gray-50 p-4">
      <dt class="text-xs text-gray-500">ステータス</dt>
      <dd class="mt-1">
        <span class="inline-block rounded-full px-2.5 py-1 text-sm font-medium <%= status_badge_classes(@product.status) %>"><%= @product.status_label %></span>
      </dd>
    </div>
  </dl>
</div>

<div class="mt-6 flex items-center gap-3">
  <%= link_to "編集する", edit_product_path(@product),
        class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-gray-700" %>
  <%= button_to "削除する", @product, method: :delete,
        class: "inline-flex items-center rounded-lg px-4 py-2.5 text-sm font-medium text-red-600 transition hover:bg-red-50",
        form: { data: { turbo_confirm: "本当に削除しますか？" } } %>
</div>
