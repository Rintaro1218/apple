<%= link_to product, id: dom_id(product), class: "group flex items-center gap-4 rounded-xl border border-gray-200/70 bg-white p-4 shadow-sm transition hover:border-gray-300 hover:shadow-md" do %>
  <div class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-indigo-50 text-base font-semibold text-indigo-600">
    <%= product.name.to_s.first %>
  </div>

  <div class="min-w-0 flex-1">
    <p class="truncate font-medium text-gray-900"><%= product.name %></p>
    <div class="mt-1 flex items-center gap-2 text-xs text-gray-500">
      <span>数量 <span class="font-medium text-gray-700"><%= product.quantity %></span></span>
      <% if product.category.present? %>
        <span class="text-gray-300">·</span>
        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-gray-600"><%= product.category %></span>
      <% end %>
      <span class="text-gray-300">·</span>
      <span class="rounded-full px-2 py-0.5 font-medium <%= status_badge_classes(product.status) %>"><%= product.status_label %></span>
    </div>
  </div>

  <svg class="h-5 w-5 shrink-0 text-gray-300 transition group-hover:translate-x-0.5 group-hover:text-gray-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd" />
  </svg>
<% end %>
