<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Vibe Coding Inventory App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased" style="font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif">
    <header class="sticky top-0 z-10 border-b border-gray-200/70 bg-white/80 backdrop-blur">
      <div class="max-w-4xl mx-auto px-6 h-16 flex items-center">
        <%= link_to root_path, class: "flex items-center gap-2.5 font-semibold tracking-tight text-gray-900" do %>
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-gray-900 text-sm text-white">在</span>
          <span>在庫管理</span>
        <% end %>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-10">
      <%= yield %>
    </main>
  </body>
</html>
