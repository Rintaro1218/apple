# ローカル開発用の Dockerfile です（docker compose から使われます）。
# 本番（Fly.io）デプロイには、Rails が用意した本番用の「Dockerfile」が使われます。
FROM ruby:3.3-slim

ENV LANG=C.UTF-8 \
    TZ=Asia/Tokyo

# Rails と PostgreSQL の利用に必要なパッケージをインストールします。
# libyaml-dev は psych（YAML 解析）のビルドに必須です。
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      libyaml-dev \
      git \
      pkg-config \
      postgresql-client && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 先に Gemfile だけコピーして bundle install することで、
# 依存ライブラリの変更がないときはビルドのキャッシュが効きます。
COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

EXPOSE 3000

# 開発用サーバーを 0.0.0.0 で起動します（コンテナの外からアクセスできるように）。
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
